# Working document, not part of the site
research-report.html

# Raw screenshot drops. The cropped, named copies under public/shots/ are what
# the site serves; these are the originals they were cut from and would ship a
# second megabyte of the same pixels.
chatbot-images/

# Source resume + extracted text: contain a phone number. Never commit.
# The PDF was missing from this list while a resume PDF sat in the repo root,
# so `git add .` would have published a phone number. Match the format, not
# the filename — the next export will be called something else again.
*.docx
*.doc
*.pdf
resume.txt

# ...but the site's own CV download has to ship. Update it by copying the
# export over this path — an export added under its own name stays ignored.
!public/cv.pdf
