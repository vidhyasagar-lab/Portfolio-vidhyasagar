---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap">
    <div class="mesh" aria-hidden="true"></div>
    <div class="shell inner">
      <p class="mono-label">404</p>
      <h1>That page retrieved nothing.</h1>
      <p class="prose">The link is broken or the page has moved. The work is all still here.</p>
      <div class="acts">
        <a class="btn-primary" href="/">Back to the work</a>
        <a class="btn-ghost" href="/experience">Read the CV</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 68vh;
    display: grid;
    align-items: center;
    padding-block: 4rem;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    max-width: 14ch;
  }

  /* This page had its own copy of the primary button, which is how it ended
     up as the one button on the site with no 44px floor. It uses the shared
     one from global.css now, and offers a second way out: someone who lands
     here from a stale link is as likely to want the CV as the work index. */
  .acts { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .6rem; }
</style>
