---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EvalConsole from '../components/EvalConsole.astro';
import ExperienceCompact from '../components/ExperienceCompact.astro';
import { site, cv } from '../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

/** "Two systems" reads better than "2 systems"; past six, the digit is fine. */
function countWord(n: number): string {
  const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
  const word = words[n] ?? String(n);
  return `${word} ${n === 1 ? 'system' : 'systems'}`;
}
---

<Base>
  {/* ---------------- HERO ---------------- */}
  <section class="hero">
    <div class="mesh" aria-hidden="true"></div>

    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="mono-label rise" style="animation-delay:.05s">
          <span class="pulse" aria-hidden="true"></span>{site.status}
        </p>

        {/* Kinetic type: each word rises from behind its own mask. */}
        <h1 class="kinetic">
          <span class="ln">
            {['I', 'build', 'agents', 'that'].map((w, i) => (
              <span class="msk"><i style={`--d:${120 + i * 65}ms`}>{w}</i></span>
            ))}
          </span>
          <span class="ln">
            <span class="msk"><i class="hl" style="--d:400ms">finish the work.</i></span>
          </span>
        </h1>

        <p class="lede rise" style="animation-delay:.24s">{site.blurb}</p>

        <div class="cta rise" style="animation-delay:.34s">
          <a class="btn-primary" href="#work">See the work</a>
          <a class="btn-ghost" href={cv} download>Download CV</a>
          <a class="btn-ghost" href={`mailto:${site.email}`}>Get in touch</a>
        </div>
      </div>

      {/* The most characteristic object in this field, made operable. */}
      <div class="panel-wrap rise" style="animation-delay:.42s">
        <EvalConsole />
      </div>
    </div>
  </section>

  {/* ---------------- EXPERIENCE ---------------- */}
  <section id="experience" class="shell block">
    <header class="block-head reveal">
      <p class="mono-label">Experience</p>
      <h2>Where the constraints were real.</h2>
      <p class="prose">Production systems, private repositories. What I owned and what changed.</p>
    </header>

    <ExperienceCompact />

    <p class="more reveal">
      <a href="/experience">Full CV — skills, certifications, education <span aria-hidden="true">&rarr;</span></a>
    </p>
  </section>

  {/* ---------------- WORK ---------------- */}
  <section id="work" class="shell block">
    <header class="block-head reveal">
      <p class="mono-label">Selected work</p>
      {/* Counted from the collection, not typed. A hard-coded number goes stale
          the first time a project is added or removed — as it already had. */}
      <h2>{countWord(projects.length)}, and what each one taught me.</h2>
      <p class="prose">Written up from the code: the architecture, the trade-offs, and what broke.</p>
    </header>

    {projects.length === 0 ? (
      <p class="empty mono-label">No projects published yet.</p>
    ) : (
      <div class="grid">
        {projects.map((p, i) => (
          <ProjectCard
            href={`/work/${p.id}`}
            title={p.data.title}
            tagline={p.data.tagline}
            role={p.data.role}
            period={p.data.period}
            stack={p.data.stack}
            repo={p.data.repo}
            repoLabel={p.data.repoLabel}
            live={p.data.live}
            outcomes={p.data.outcomes}
            index={i}
            slug={p.id}
          />
        ))}
      </div>
    )}
  </section>

  {/* ---------------- APPROACH (the one neumorphic surface) ---------------- */}
  <section id="approach" class="shell block">
    <header class="block-head reveal">
      <p class="mono-label">Approach</p>
      <h2>Demos are easy. Evidence is the job.</h2>
    </header>

    <div class="tenets">
      {[
        {
          n: 'Evaluate before you optimise',
          d: 'A retrieval change that improves vibes and degrades recall is a regression. I build the harness before I tune the system, so improvement is a number rather than an impression.',
        },
        {
          n: 'Cost and latency are features',
          d: 'A model choice is a three-way trade between quality, p95 latency and cost per call. I price that trade explicitly instead of defaulting to the largest model available.',
        },
        {
          n: 'Design for the failure case',
          d: 'Language models fail confidently. The interesting engineering is in detecting low-confidence output, falling back gracefully, and making the failure legible to the user.',
        },
      ].map((t, i) => (
        <article data-tilt class="tenet neu reveal" style={`transition-delay:${i * 90}ms`}>
          <h3>{t.n}</h3>
          <p>{t.d}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ---------------- CONTACT ---------------- */}
  <section id="contact" class="shell block">
    <div class="contact glass reveal">
      <div class="mesh" aria-hidden="true"></div>
      <div class="contact-inner">
        <p class="mono-label">Contact</p>
        <h2>Let's talk about the hard part.</h2>
        <p class="contact-lede glass-dim">
          If you're building something where model reliability actually matters, I'd like to hear
          about it — including the parts that aren't working yet.
        </p>
        <div class="cta">
          <a class="btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn-ghost" href={site.github} rel="noopener noreferrer" target="_blank">GitHub</a>
          <a class="btn-ghost" href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */

  .hero {
    position: relative;
    isolation: isolate;
    /* The nav is sticky, not fixed, so it already takes its own height out of
       the flow. Padding here only needs to be breathing room under it — the
       old clamp(4.5rem, 13vh, 8rem) was clearance for a nav that floats, and
       stacked ~128px of dead space on top of the nav's own ~70px. */
    padding-block: clamp(1rem, 3vh, 2.25rem) clamp(3rem, 8vh, 5rem);
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  }

  .hero-copy { display: grid; gap: 1.4rem; justify-items: start; }

  /* The copy and console sit over the field; let drags through the gaps. */
  .hero-grid { pointer-events: none; }
  .hero-copy > *,
  .panel-wrap { pointer-events: auto; }

  .pulse {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    margin-right: .55rem;
    vertical-align: middle;
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: ping 2.6s ease-out infinite;
  }

  @keyframes ping {
    0%   { box-shadow: 0 0 0 0 var(--accent-glow); }
    70%  { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  h1 {
    font-size: clamp(2.9rem, 8.5vw, 5.6rem);
    letter-spacing: -.045em;
  }

  /* --- kinetic type --- */

  .kinetic .ln {
    display: block;
    /* The mask clips to the line box; padding stops descenders being sheared. */
    overflow: hidden;
    padding-bottom: .12em;
    margin-bottom: -.12em;
  }

  .kinetic .msk {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: .1em;
    margin-bottom: -.1em;
  }

  .kinetic .msk + .msk { margin-left: .26em; }

  .kinetic i {
    display: inline-block;
    font-style: normal;
    transform: translate3d(0, 108%, 0);
    animation: kin .85s cubic-bezier(.19, .84, .28, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  .kinetic .hl { color: var(--accent); }

  @keyframes kin {
    to { transform: translate3d(0, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kinetic i { transform: none; animation: none; }
  }

  .lede {
    max-width: 46ch;
    font-size: clamp(1.02rem, 1.7vw, 1.2rem);
    line-height: 1.62;
    color: var(--ink-2);
  }

  .cta { display: flex; flex-wrap: wrap; gap: .7rem; }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: .72rem 1.35rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: transform .25s, background-color .25s, border-color .25s, color .25s;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .btn-ghost {
    border-color: var(--line-strong);
    color: var(--ink-2);
  }

  .btn-primary:hover { transform: translateY(-2px); }
  .btn-ghost:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---------------- eval panel ---------------- */

  .panel {
    padding: 1.35rem 1.4rem 1.2rem;
    border-radius: 16px;
    display: grid;
    gap: 1.1rem;
    width: 100%;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--glass-ink) 16%, transparent);
  }

  .mono { font-family: var(--f-mono); }

  .tiny {
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .panel-head .mono:first-child { color: var(--glass-ink); }

  .ok {
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }

  .ok::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .8rem;
  }

  .bars li {
    display: grid;
    grid-template-columns: 8.5rem 1fr 2.6rem;
    align-items: center;
    gap: .75rem;
  }

  .track {
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--glass-ink) 16%, transparent);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    width: var(--v);
    border-radius: inherit;
    background: var(--accent);
    transform-origin: left;
    animation: grow 1.1s cubic-bezier(.22,.68,.28,1) .6s backwards;
  }

  .fill.low { background: var(--glass-ink-2); }

  @keyframes grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .val {
    text-align: right;
    color: var(--glass-ink);
    font-variant-numeric: tabular-nums;
  }

  .panel-foot {
    padding-top: .85rem;
    border-top: 1px solid color-mix(in srgb, var(--glass-ink) 16%, transparent);
    letter-spacing: .06em;
    text-transform: none;
  }

  @media (max-width: 26rem) {
    .bars li { grid-template-columns: 7rem 1fr 2.4rem; gap: .5rem; }
  }

  /* ---------------- blocks ---------------- */

  /* Applies to top AND bottom, so the gap a reader sees between two sections is
     twice this. Keep that in mind before raising it: at the old
     clamp(3.5rem, 9vh, 6rem) adjacent sections sat up to 12rem apart. */
  .block { padding-block: clamp(2.5rem, 5.5vh, 4rem); }

  .block-head {
    display: grid;
    gap: .85rem;
    margin-bottom: 2rem;
  }

  .block-head h2 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    max-width: 20ch;
  }

  .grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 44rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .empty {
    padding: 3rem 0;
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: 14px;
  }

  /* ---------------- tenets (neumorphic) ---------------- */

  /* ---------------- link to full CV ---------------- */

  .more { margin-top: 2rem; }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--f-mono);
    font-size: .76rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: .25rem;
    transition: border-color .25s;
  }

  .more a:hover { border-bottom-color: var(--accent); }
  .more span { transition: transform .3s cubic-bezier(.22,.68,.28,1); }
  .more a:hover span { transform: translateX(4px); }

  /* ---------------- credentials strip (unused, kept for reference) ---------------- */

  .creds {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56rem) {
    .creds { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .cred .mono-label { margin-bottom: .7rem; }

  .cred ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .45rem;
    font-size: .9rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cred b {
    display: block;
    font-weight: 600;
    color: var(--ink-2);
  }

  .tenets {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 52rem) { .tenets { grid-template-columns: repeat(3, 1fr); } }

  .tenet {
    padding: 1.5rem 1.45rem;
    display: grid;
    gap: .6rem;
    align-content: start;
  }

  .tenet h3 {
    font-size: 1.08rem;
    letter-spacing: -.02em;
    color: var(--ink);
  }

  .tenet p {
    font-size: .96rem;
    line-height: 1.62;
    color: var(--ink-2);
  }

  /* ---------------- contact ---------------- */

  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 22px;
    padding: clamp(2.25rem, 6vw, 4rem);
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .contact h2 {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    color: var(--glass-ink);
  }

  .contact .mono-label { color: var(--glass-ink-2); }

  .contact-lede {
    max-width: 48ch;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .contact .btn-ghost {
    border-color: color-mix(in srgb, var(--glass-ink) 32%, transparent);
    color: var(--glass-ink);
  }

  .contact .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
