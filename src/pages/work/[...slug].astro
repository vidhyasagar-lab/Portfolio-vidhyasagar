---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;

// Reading time from the raw MDX source. 225 wpm is the usual prose average;
// this runs slightly long if anything, since code and tables read slower.
const words = (project.body ?? '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 225));

// h2 only. Indexing h3s would make the rail taller than the sections it points at.
const sections = headings.filter((h) => h.depth === 2);

// The gallery opens on the cover, because the cover is screen one — it is the
// image already on the page, so opening on anything else would be a jump cut.
// `shots` supplies the rest.
const galleryId = `screens-${project.id}`;
const screens = [
  ...(d.cover
    ? [{
        src: d.cover.src,
        alt: d.cover.alt,
        caption: d.cover.caption ?? d.cover.alt,
        title: d.cover.title,
        description: d.cover.description,
        width: d.cover.width,
        height: d.cover.height,
      }]
    : []),
  ...d.shots,
];
---

<Base title={`${d.title} — ${site.name}`} description={d.tagline}>
  {/* Scroll-driven, pure CSS. Hidden entirely where unsupported. */}
  <div class="read-progress" aria-hidden="true"></div>

  <article>
    {/* --------- masthead --------- */}
    <header class="head">
      <div class="mesh" aria-hidden="true"></div>

      <div class="shell head-inner">
        <a class="back mono-label" href="/#work">
          <span aria-hidden="true">←</span> All work
        </a>

        <p class="mono-label rise" style="animation-delay:.05s">
          {d.period} <span class="dot" aria-hidden="true">·</span> {readMin} min read
        </p>
        <h1 style={`view-transition-name: t-${project.id}`}>{d.title}</h1>
        <p class="tagline rise" style="animation-delay:.2s">{d.tagline}</p>
        <p class="byline rise" style="animation-delay:.24s">{d.role}</p>

        <div class="actions rise" style="animation-delay:.28s">
          {d.live && (
            <a class="btn-primary" href={d.live} rel="noopener noreferrer" target="_blank">
              Open live app
            </a>
          )}
          {d.repo && (
            <a class="btn-ghost" href={d.repo} rel="noopener noreferrer" target="_blank">
              {/* Defaults to "View source". Overridden when the link is not the
                  project's own repo — promising source and delivering a profile
                  is a broken promise, just a quiet one. */}
              {d.repoLabel ?? 'View source'}
            </a>
          )}
          {/* Sits with the repo and live links because it is the same kind of
              thing: evidence the project exists. Renders nothing when there
              are no screens. */}
          <ScreenGallery id={galleryId} screens={screens} projectTitle={d.title} />
        </div>
      </div>
    </header>

    <div class="shell layout">
      {/* --------- sticky rail: contents + the facts that were in the glance card --------- */}
      <aside class="rail">
        {sections.length > 0 && (
          <nav class="toc" aria-label="Contents">
            <p class="mono-label rail-h">Contents</p>
            <ol>
              {sections.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        {d.outcomes.length > 0 && (
          <div class="facts">
            <p class="mono-label rail-h">Key figures</p>
            <dl class="metrics">
              {d.outcomes.map((o) => (
                <div>
                  <dt>{o.metric}</dt>
                  <dd>{o.label}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <div class="facts">
          <p class="mono-label rail-h">Built with</p>
          <ul class="stack">
            {d.stack.map((s) => <li class="mono-chip">{s}</li>)}
          </ul>
        </div>
      </aside>

      {/* --------- the article itself --------- */}
      <div class="doc">
        {d.cover && (
          /* `priority` is the whole point here: this is the LCP element, so it
             loads eagerly at high priority. It is the only image on the page
             that should. */
          <Figure
            variant="hero"
            priority
            opens={galleryId}
            class="reveal"
            src={d.cover.src}
            alt={d.cover.alt}
            width={d.cover.width ?? 1600}
            height={d.cover.height ?? 1000}
            caption={d.cover.caption}
            title={d.cover.title}
            description={d.cover.description}
          />
        )}

        {/* The standfirst. Stating the hard part before the prose gives the
            reader the stakes up front, which is what the glance card did. */}
        <p class="lede reveal">{d.problem}</p>

        <div class="body reveal">
          <div class="prose">
            <Content />
          </div>
        </div>

        {/* No inline Screens strip: `shots` feeds the gallery in the masthead
            instead, so the screens live in one viewer rather than two places. */}

        <section class="next reveal">
          <a href="/#work" class="btn-ghost">← Back to all work</a>
          <a href={`mailto:${site.email}`} class="btn-primary">Ask me about this project</a>
        </section>
      </div>
    </div>
  </article>
</Base>

<script>
  /* Code blocks and tables scroll sideways on a narrow screen, but a plain
     <pre> cannot be focused, so a keyboard user can never reach the half of a
     line that is off-screen. MDX generates these, so the attribute has to be
     added here rather than in the markup.

     Only the ones that actually overflow get it — a focus stop on a block
     that fits is a stop that does nothing, which is its own annoyance. */
  function markScrollables() {
    const blocks = document.querySelectorAll<HTMLElement>('.body pre, .body table');
    blocks.forEach((el) => {
      const scrolls = el.scrollWidth > el.clientWidth;
      if (scrolls) {
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'region');
        el.setAttribute('aria-label', el.tagName === 'PRE' ? 'Code block' : 'Table');
      } else {
        el.removeAttribute('tabindex');
        el.removeAttribute('role');
        el.removeAttribute('aria-label');
      }
    });
  }

  markScrollables();
  // Rotating a phone changes which blocks overflow.
  window.addEventListener('resize', markScrollables, { passive: true });
</script>

<style>
  /* --------- masthead --------- */

  .head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 9vh, 5.5rem) clamp(2rem, 5vh, 3rem);
  }

  .head-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.05rem;
    justify-items: start;
  }

  .back {
    /* inline-flex + min-height rather than display:block: this sits above the
       title, so it must not stretch the full column and swallow taps meant
       for the heading. 18px of text was the smallest target on the page. */
    display: inline-flex;
    align-items: center;
    /* A flex container drops the whitespace between its items, so the space
       in "← All work" vanished when this stopped being inline. */
    gap: .4rem;
    min-height: 44px;
    color: var(--ink-3);
    margin-bottom: .75rem;
    transition: color .2s;
  }

  .back:hover { color: var(--accent); }

  .dot { color: var(--line-strong); margin-inline: .3rem; }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    letter-spacing: -.045em;
    max-width: 16ch;
  }

  .tagline {
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.7vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .byline {
    font-family: var(--f-mono);
    font-size: .76rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }

  .actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .4rem; }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .72rem 1.35rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: transform .25s, border-color .25s, color .25s;
  }

  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-ghost { border-color: var(--line-strong); color: var(--ink-2); }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-ghost:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }

  /* --------- layout: rail + article ---------
     Same shape as /experience, so the two long-form pages read as one system. */

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 64rem) {
    /* The article fills the full .shell width — no centred column, no empty
       band beside the text. Long lines are the cost, so the type below is set
       looser and slightly larger to keep them tracking. */
    .layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .rail { display: grid; gap: 1.75rem; align-content: start; }

  @media (min-width: 64rem) {
    .rail {
      position: sticky;
      top: 6rem;
      align-self: start;
      /* A sticky element taller than the viewport strands its own bottom:
         it stays pinned at `top`, so the overflow below the fold can never
         be scrolled into view. Bounding it to the visible height and letting
         it scroll internally is what makes the last group reachable. */
      max-height: calc(100vh - 7.5rem);
      overflow-y: auto;
      /* Don't hand the scroll back to the page when the rail hits its end. */
      overscroll-behavior: contain;
      padding-right: .4rem;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
    }

    /* WebKit needs its own pass; the rail is chrome, so keep it faint. */
    .rail::-webkit-scrollbar { width: 6px; }
    .rail::-webkit-scrollbar-track { background: transparent; }
    .rail::-webkit-scrollbar-thumb {
      background: var(--line-strong);
      border-radius: 3px;
    }
  }

  .rail-h { color: var(--ink-3); margin-bottom: .7rem; }

  /* Contents is navigation, not content: on a phone it would push the article
     down without helping, since the whole page is one thumb-scroll anyway. */
  .toc { display: none; }

  @media (min-width: 64rem) {
    .toc { display: block; }
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .1rem;
  }

  .toc a {
    display: block;
    padding: .38rem 0 .38rem .85rem;
    border-left: 1px solid var(--line);
    font-size: .78rem;
    line-height: 1.35;
    color: var(--ink-3);
    transition: color .2s, border-color .2s;
  }

  .toc a:hover {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* --------- rail facts --------- */

  .facts { display: block; }

  .metrics { display: grid; gap: .9rem; margin: 0; }

  .metrics div { display: grid; gap: .1rem; }

  .metrics dt {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .metrics dd {
    margin: 0;
    font-size: .76rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mono-chip {
    font-family: var(--f-mono);
    font-size: .66rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .26rem .55rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--ink-3);
  }

  /* --------- article --------- */

  .doc { min-width: 0; }

  .lede {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.42;
    letter-spacing: -.022em;
    color: var(--ink);
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--line);
  }

  .body { padding-block: clamp(1.75rem, 5vh, 2.5rem); }

  /* Full width by choice. The counterweight is below: longer lines need more
     leading and more space between paragraphs, or the eye loses its place on
     the return sweep. */
  .prose { max-width: none; }

  .body :global(p) {
    margin: 0 0 1.4em;
    font-size: 1.06rem;
    line-height: 1.85;
    color: var(--ink-2);
  }

  .body :global(h2) {
    font-size: clamp(1.45rem, 3vw, 1.95rem);
    margin: 2.75rem 0 .9rem;
    color: var(--ink);
    /* Clears the fixed nav when a Contents link jumps here. */
    scroll-margin-top: 5.5rem;
  }

  .body :global(h2:first-child) { margin-top: 0; }

  .body :global(h3) {
    font-size: 1.1rem;
    margin: 2rem 0 .6rem;
    color: var(--ink);
    scroll-margin-top: 5.5rem;
  }

  /* Two things have to be undone for markers to appear inside prose.
     1. Tailwind's preflight sets `ol,ul,menu{list-style:none}` site-wide, so the
        list type has to be put back explicitly — nothing else here restores it.
     2. Not display:grid. Grid turns the <li>s into grid items, which don't lay
        out a marker box, so spacing comes from margins on the items instead. */
  .body :global(ul),
  .body :global(ol) {
    margin: 1.25rem 0;
    /* Wide enough for a two-digit marker plus its gap, so "10." doesn't clip. */
    padding-left: 1.75rem;
    color: var(--ink-2);
    line-height: 1.7;
  }

  .body :global(ul) { list-style: disc outside; }
  .body :global(ol) { list-style: decimal outside; }
  .body :global(ul ul) { list-style: circle outside; }

  /* Images placed inline in a section, beside the prose they illustrate.
     Markdown emits a bare <img> in a <p>; both are handled so a caption can be
     written either as an italic line under the image or not at all. */
  .body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.75rem 0 .65rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 14px 40px -26px rgba(0, 0, 0, .55);
  }

  /* Figures in body copy come from <Figure>, which styles its own markup and
     wins on specificity. Nothing is defined here on purpose — two sources of
     truth for the same element is how spacing rules start cancelling out. */

  .body :global(li) { margin-bottom: .55rem; }
  .body :global(li:last-child) { margin-bottom: 0; }

  .body :global(li::marker) {
    color: var(--accent);
    font-weight: 600;
  }

  /* Nested lists shouldn't inherit the outer list's top margin. */
  .body :global(li > ul),
  .body :global(li > ol) { margin: .55rem 0 0; }

  .body :global(blockquote) {
    margin: 1.75rem 0;
    padding: .25rem 0 .25rem 1.15rem;
    border-left: 3px solid var(--accent);
    color: var(--ink);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.45;
    letter-spacing: -.02em;
  }

  .body :global(code) {
    font-family: var(--f-mono);
    font-size: .85em;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: .1em .35em;
    border-radius: 4px;
    /* An identifier like `allow_dangerous_deserialization=True` has no space
       to break at, so on a narrow screen it pushed the whole page wider than
       the viewport. `anywhere` also lets it shrink the line box, which
       `break-word` does not. Block code is untouched — <pre> scrolls. */
    overflow-wrap: anywhere;
  }

  /* Code and tables get the full column, not the prose measure — wrapping a
     diagram to 66ch would break it. */
  .body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: .84rem;
    line-height: 1.55;
  }

  .body :global(pre code) { background: none; border: 0; padding: 0; }

  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-mono);
    font-size: .8rem;
    font-variant-numeric: tabular-nums;
    margin: 1.5rem 0;
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: .6rem .75rem;
    border-bottom: 1px solid var(--line);
  }

  .body :global(th) {
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* --------- hero screenshot --------- */

  /* --------- next --------- */


  /* --------- next --------- */

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
