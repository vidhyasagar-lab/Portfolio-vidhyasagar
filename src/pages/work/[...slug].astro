---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={`${d.title} — ${site.name}`} description={d.tagline}>
  {/* Scroll-driven, pure CSS. Hidden entirely where unsupported. */}
  <div class="read-progress" aria-hidden="true"></div>

  <article>
    {/* --------- header --------- */}
    <header class="head">
      <div class="mesh" aria-hidden="true"></div>

      <div class="shell head-inner">
        <a class="back mono-label" href="/#work">
          <span aria-hidden="true">←</span> All work
        </a>

        <p class="mono-label rise" style="animation-delay:.05s">{d.period} · {d.role}</p>
        <h1 style={`view-transition-name: t-${project.id}`}>{d.title}</h1>
        <p class="tagline rise" style="animation-delay:.2s">{d.tagline}</p>

        <div class="actions rise" style="animation-delay:.28s">
          {d.live && (
            <a class="btn-primary" href={d.live} rel="noopener noreferrer" target="_blank">
              Open live app
            </a>
          )}
          {d.repo && (
            <a class="btn-ghost" href={d.repo} rel="noopener noreferrer" target="_blank">
              {/* Defaults to "View source". Overridden when the link is not the
                  project's own repo — promising source and delivering a profile
                  is a broken promise, just a quiet one. */}
              {d.repoLabel ?? 'View source'}
            </a>
          )}
        </div>
      </div>
    </header>

    {/* --------- hero screenshot --------- */}
    {d.cover && (
      <section class="shell cover-wrap">
        <figure class="cover reveal">
          {/* Eager + high priority: this is the LCP element, so lazy-loading it
              would delay the very metric it dominates. The opposite of .shot,
              which is below the fold and correctly lazy. */}
          <img
            src={d.cover.src}
            alt={d.cover.alt}
            width={d.cover.width}
            height={d.cover.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </section>
    )}

    {/* --------- at a glance --------- */}
    <section class="shell glance-wrap">
      <div data-tilt class="glance glass reveal">
        <div class="glance-col">
          <p class="mono-label">The hard part</p>
          <p class="problem">{d.problem}</p>
        </div>

        {d.outcomes.length > 0 && (
          <dl class="metrics">
            {d.outcomes.map((o) => (
              <div>
                <dt>{o.metric}</dt>
                <dd class="glass-dim">{o.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <ul class="stack reveal">
        {d.stack.map((s) => <li class="mono-chip">{s}</li>)}
      </ul>
    </section>

    {/* --------- body --------- */}
    <div class="shell body reveal">
      <div class="prose">
        <Content />
      </div>
    </div>

    {/* --------- screenshots --------- */}
    {d.shots.length > 0 && (
      <section class="shell shots">
        <p class="mono-label reveal">Screens</p>
        {d.shots.map((shot, i) => (
          <figure class="shot reveal" style={`transition-delay:${i * 80}ms`}>
            <img src={shot.src} alt={shot.caption} loading="lazy" decoding="async" />
            <figcaption class="mono-label">{shot.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {/* --------- next --------- */}
    <section class="shell next reveal">
      <a href="/#work" class="btn-ghost">← Back to all work</a>
      <a href={`mailto:${site.email}`} class="btn-primary">Ask me about this project</a>
    </section>
  </article>
</Base>

<style>
  .head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 9vh, 5.5rem) clamp(2.5rem, 7vh, 4rem);
  }

  .head-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.05rem;
    justify-items: start;
  }

  .back {
    color: var(--ink-3);
    margin-bottom: 1.25rem;
    transition: color .2s;
  }

  .back:hover { color: var(--accent); }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    letter-spacing: -.045em;
    max-width: 16ch;
  }

  .tagline {
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.7vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .4rem; }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: .72rem 1.35rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: transform .25s, border-color .25s, color .25s;
  }

  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-ghost { border-color: var(--line-strong); color: var(--ink-2); }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-ghost:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }

  /* --------- glance --------- */

  .glance-wrap { display: grid; gap: 1.1rem; padding-bottom: 1rem; }

  .glance {
    display: grid;
    gap: 1.75rem;
    padding: 1.6rem 1.55rem;
    border-radius: 18px;
  }

  @media (min-width: 54rem) {
    .glance { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  }

  .glance .mono-label { color: var(--glass-ink-2); margin-bottom: .5rem; }

  .problem {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2.1vw, 1.4rem);
    line-height: 1.34;
    letter-spacing: -.025em;
    color: var(--glass-ink);
    max-width: 40ch;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 1.1rem;
    margin: 0;
  }

  .metrics div { display: grid; gap: .15rem; }

  .metrics dt {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .metrics dd {
    margin: 0;
    font-size: .78rem;
    line-height: 1.4;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mono-chip {
    font-family: var(--f-mono);
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: .3rem .65rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    color: var(--ink-3);
  }

  /* --------- body --------- */

  .body { padding-block: clamp(2.5rem, 7vh, 4rem); }

  .body :global(h2) {
    font-size: clamp(1.45rem, 3vw, 1.95rem);
    margin: 2.75rem 0 .9rem;
    color: var(--ink);
  }

  .body :global(h2:first-child) { margin-top: 0; }

  .body :global(h3) {
    font-size: 1.1rem;
    margin: 2rem 0 .6rem;
    color: var(--ink);
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 1rem 0;
    padding-left: 1.25rem;
    display: grid;
    gap: .45rem;
  }

  .body :global(li::marker) { color: var(--accent); }

  .body :global(blockquote) {
    margin: 1.5rem 0;
    padding: .25rem 0 .25rem 1.15rem;
    border-left: 3px solid var(--accent);
    color: var(--ink);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.45;
    letter-spacing: -.02em;
  }

  .body :global(code) {
    font-family: var(--f-mono);
    font-size: .85em;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: .1em .35em;
    border-radius: 4px;
  }

  .body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: .84rem;
  }

  .body :global(pre code) { background: none; border: 0; padding: 0; }

  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-mono);
    font-size: .8rem;
    font-variant-numeric: tabular-nums;
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: .6rem .75rem;
    border-bottom: 1px solid var(--line);
  }

  .body :global(th) {
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* --------- hero screenshot --------- */

  .cover-wrap { padding-bottom: clamp(1.5rem, 4vh, 2.5rem); }

  .cover { margin: 0; }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 1px solid var(--line);
    /* A screenshot is a rectangle of someone else's UI dropped onto the page.
       The surface behind it and a soft lift keep it sitting on the design
       rather than punched through it. */
    background: var(--surface);
    box-shadow: 0 18px 50px -28px rgba(0, 0, 0, .55);
  }

  /* --------- shots --------- */

  .shots { display: grid; gap: 1.25rem; padding-bottom: 2rem; }

  .shot { margin: 0; display: grid; gap: .65rem; }

  .shot img {
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .shot figcaption { color: var(--ink-3); }

  /* --------- next --------- */

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
