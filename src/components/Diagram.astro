---
/**
 * Frame for an inline SVG architecture diagram in a case study.
 *
 * The SVG is slotted rather than generated, because these are all different
 * shapes — a loop-bearing agent graph and a fan-out both read badly through a
 * generic node/edge renderer.
 *
 * Colours inside the slotted SVG come from the site's own theme tokens via
 * `fill="var(--surface)"` and friends: SVG presentation attributes are parsed
 * as CSS values, so a custom property works there and the diagram follows the
 * light/dark switch with no second copy.
 *
 * `label` is what a screen reader gets — the whole point of a diagram is lost
 * on one, so write the flow out as a sentence, not "architecture diagram".
 */
interface Props {
  /** Sentence describing the flow, for anyone who cannot see the image. */
  label: string;
  caption?: string;
}

const { label, caption } = Astro.props;
---

<figure class="diagram">
  {/* tabindex makes the scroll box reachable by keyboard: a scrollable region
      that only a mouse or thumb can pan is unusable without one, and it is an
      explicit WCAG requirement. */}
  <div class="scroll" role="img" aria-label={label} tabindex="0">
    <slot />
  </div>
  <figcaption>
    {caption}
    {/* Only rendered narrow, where the diagram genuinely overflows. Without
        it a phone reader sees a cropped diagram and no sign it moves. */}
    <span class="hint" aria-hidden="true">Scroll the diagram sideways to see all of it →</span>
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 1.9rem 0;
  }

  /* Wide diagrams scroll inside their own box; the page body never scrolls
     sideways. */
  .scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 1.35rem 1.25rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--accent) 5%, transparent), transparent 62%),
      var(--surface);
    scrollbar-width: thin;
  }

  .diagram :global(svg) {
    display: block;
    width: 100%;
    min-width: 30rem;
    height: auto;
  }

  .scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: .7rem;
    font-family: var(--f-mono);
    font-size: .72rem;
    letter-spacing: .04em;
    color: var(--ink-3);
  }

  /* The SVG floor is 30rem plus 2.5rem of padding, so the box starts
     overflowing just under 33rem. Show the hint only where that is true. */
  .hint { display: none; }

  @media (max-width: 33rem) {
    .hint {
      display: block;
      margin-top: .3rem;
      color: var(--accent);
    }
  }
</style>
