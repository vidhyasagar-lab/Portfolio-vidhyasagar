---
import { getCollection } from 'astro:content';

const roles = (await getCollection('experience', ({ data }) => !data.draft))
  .sort((a, b) => b.data.order - a.data.order);
---

{roles.length > 0 && (
  <ul class="list">
    {roles.map((r, i) => (
      <li class="row reveal" style={`transition-delay:${i * 80}ms`}>
        {/* The company leads in reading order; the grid still puts the dates
            in the left column on a wide screen. */}
        <div class="what">
          <h3>{r.data.company}</h3>
          <p class="role">{r.data.role}</p>
          <p class="desc">{r.data.summary}</p>
        </div>

        <div class="when">{r.data.period}</div>

        <dl class="figs">
          {r.data.impact.slice(0, 2).map((m) => (
            <div>
              <dt>{m.metric}</dt>
              <dd>{m.label}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ul>
)}

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: .75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }

  .row:last-child { border-bottom: 1px solid var(--line); }

  /* Dates left, detail centre, figures right — the F-pattern scan order. */
  @media (min-width: 62rem) {
    .row {
      grid-template-columns: 10rem minmax(0, 1fr) 16rem;
      gap: 2.5rem;
      align-items: start;
    }

    .when { grid-column: 1; grid-row: 1; }
    .what { grid-column: 2; grid-row: 1; }
    .figs { grid-column: 3; grid-row: 1; }
  }

  /* "to present" already says which role is current; no dot needed. */
  .when {
    font-size: .86rem;
    color: var(--ink-3);
    padding-top: .35rem;
  }

  .what { display: grid; gap: .3rem; }

  h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
    letter-spacing: -.03em;
    color: var(--ink);
  }

  .role {
    font-size: .9rem;
    font-weight: 600;
    color: var(--accent);
  }

  .desc {
    margin-top: .35rem;
    max-width: 32.94em;  /* 54ch x .610 */
    font-size: .97rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .figs {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding-top: .2rem;
  }

  .figs div { display: grid; gap: .1rem; }

  .figs dt {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .figs dd {
    margin: 0;
    font-size: .76rem;
    line-height: 1.35;
    color: var(--ink-3);
    /* With the 16rem track, wide enough that "evaluation layers: RAGAS,
       DeepEval, Langfuse" sets in three lines rather than a four-line sliver. */
    max-width: 12em;
  }
</style>
