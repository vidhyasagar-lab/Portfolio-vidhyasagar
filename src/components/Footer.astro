---
import { site } from '../site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell inner">
    <p class="mono-label">© {year} {site.name}</p>
    <p class="mono-label built">Astro · Tailwind · Vercel</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    margin-top: 6rem;
    padding-block: 2rem;
    background: var(--bg);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .built { color: var(--ink-3); }
</style>
