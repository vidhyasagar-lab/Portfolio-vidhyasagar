---
interface Props {
  href: string;
  title: string;
  tagline: string;
  role: string;
  period: string;
  stack: string[];
  repo?: string;
  repoLabel?: string;
  live?: string;
  outcomes?: { metric: string; label: string }[];
  index: number;
  /** Used for the view-transition name that morphs card title -> case study headline. */
  slug: string;
}

const { href, title, tagline, role, period, stack, repo, repoLabel, live, outcomes = [], index, slug } = Astro.props;
---

<article data-tilt class="card glass reveal" style={`transition-delay:${index * 90}ms`}>
  <a class="hit" href={href} aria-label={`Read the ${title} case study`}></a>

  <header>
    <p class="mono meta">{period} · {role}</p>
    <h3 style={`view-transition-name: t-${slug}`}>{title}</h3>
    <p class="tagline glass-dim">{tagline}</p>
  </header>

  {/* Always rendered, even when empty: the card subgrids onto the page grid so
      that metrics and chips line up across a row, and that needs every card to
      have the same four children. `data-empty` drops the rule and padding so an
      outcome-less card shows a blank band rather than a stray line. */}
  <dl class="outcomes" data-empty={outcomes.length === 0}>
    {outcomes.map((o) => (
      <div>
        <dt>{o.metric}</dt>
        <dd class="glass-dim">{o.label}</dd>
      </div>
    ))}
  </dl>

  <ul class="stack">
    {stack.slice(0, 5).map((s) => <li class="mono">{s}</li>)}
  </ul>

  <footer>
    <span class="read">Read case study <span aria-hidden="true">→</span></span>
    <span class="links">
      {repo && (
        <a href={repo} rel="noopener noreferrer" target="_blank" title={repoLabel ?? 'Source code'}>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          <span class="sr">{repoLabel ? `${repoLabel} — ${title}` : `Source code for ${title}`}</span>
        </a>
      )}
      {live && (
        <a href={live} rel="noopener noreferrer" target="_blank" title="Live deployment">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M6.5 2.5H2.8A1.3 1.3 0 0 0 1.5 3.8v9.4a1.3 1.3 0 0 0 1.3 1.3h9.4a1.3 1.3 0 0 0 1.3-1.3V9.5M9.5 1.5h5v5M14.5 1.5 7 9"/>
          </svg>
          <span class="sr">Live deployment of {title}</span>
        </a>
      )}
    </span>
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.6rem 1.5rem 1.35rem;
    border-radius: 18px;
    transition: transform .45s cubic-bezier(.22,.68,.28,1),
                box-shadow .45s cubic-bezier(.22,.68,.28,1),
                border-color .35s;
  }

  /*
    Cross-card alignment.

    The role line wraps to two or three lines depending on how long the role
    string happens to be, and in a flex column every band below it inherits
    that drift: measured at 1440px, the metric rows sat 18px apart and the
    stack chips 33px apart. Only the footer held, because it has margin-top:
    auto. Subgrid hands the card's four rows to the page grid, so every card
    in a row shares one set of row heights and the bands line up by
    construction rather than by the roles happening to be the same length.

    Guarded twice: @supports because a browser without subgrid must keep the
    flex column, and the media query because below 44rem the grid is a single
    column and there is nothing to align against.
  */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 44rem) {
      .card {
        display: grid;
        grid-template-rows: subgrid;
        /* Six bands: role, title, tagline, metrics, stack, footer. */
        grid-row: span 6;
        /* A subgrid inherits the parent's gap; state it so the rhythm inside
           a card stays the card's, not the grid's. */
        row-gap: 1.15rem;
      }

      /* The header nests a second subgrid so the three bands it holds line up
         too. Without this the titles still sat ~12px apart whenever the role
         above them wrapped to a different number of lines. */
      .card > header {
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: .45rem;
      }

      /* Subgrid pins the footer to the last row — the auto margin would now
         fight it. */
      .card > footer { margin-top: 0; }
    }
  }

  .card:hover,
  .card:focus-within {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--glass-border));
    box-shadow: var(--glass-shadow), 0 0 0 1px var(--accent-glow);
  }

  /* Pressed. The whole card is the target, so the whole card answers — and it
     has to override the tilt transform, which is why it repeats the lift. */
  .card:has(.hit:active) {
    transform: translate3d(0, 0, 0) scale(.99);
    transition-duration: .08s;
  }

  /* Whole card is clickable, but the repo/live links stay independent. */
  .hit {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  header { display: grid; gap: .45rem; }

  .meta { color: var(--glass-ink-2); }

  .mono {
    font-family: var(--f-mono);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    color: var(--glass-ink);
  }

  .tagline {
    font-size: .97rem;
    line-height: 1.55;
  }

  .outcomes {
    display: flex;
    flex-wrap: wrap;
    /* Subgrid stretches these to the row height, which a wrapping flex
       container would otherwise use to space its lines apart. */
    align-content: start;
    gap: .35rem 1.75rem;
    margin: 0;
    padding: .9rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--glass-ink) 14%, transparent);
  }

  .outcomes[data-empty="true"] { border-top: 0; padding-top: 0; }

  .outcomes div { display: grid; gap: .1rem; }

  .outcomes dt {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .outcomes dd {
    margin: 0;
    font-size: .74rem;
    line-height: 1.35;
    max-width: 11ch;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: .35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    padding: .22rem .55rem;
    border-radius: 5px;
    border: 1px solid color-mix(in srgb, var(--glass-ink) 20%, transparent);
    color: var(--glass-ink-2);
    letter-spacing: .09em;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: .3rem;
  }

  .read {
    font-family: var(--f-mono);
    font-size: .74rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .read span {
    display: inline-block;
    transition: transform .35s cubic-bezier(.22,.68,.28,1);
  }

  .card:hover .read span { transform: translateX(4px); }

  .links {
    position: relative;
    z-index: 2;
    display: flex;
    gap: .3rem;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    position: relative;
    color: var(--glass-ink-2);
    border: 1px solid transparent;
    transition: color .2s, background-color .2s, border-color .2s;
  }

  /* The chip stays 30px so the card's proportions hold, but a 30px target is
     mean to a thumb. This grows the *hit* area to 44px without moving
     anything: the card's own stretched link sits at z-index 1, so this has to
     sit above it or the icon link becomes unreachable. */
  @media (pointer: coarse) {
    .links a::after {
      content: '';
      position: absolute;
      inset: -7px;
      z-index: 2;
    }
  }

  .links a:hover {
    color: var(--glass-ink);
    background: color-mix(in srgb, var(--glass-ink) 12%, transparent);
    border-color: color-mix(in srgb, var(--glass-ink) 20%, transparent);
  }

  .sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
